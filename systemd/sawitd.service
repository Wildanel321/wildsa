[Unit]
Description=SawitOS Core Daemon and Management API
After=network.target sawit-agent.service
Wants=sawit-agent.service
Documentation=file:///usr/share/doc/sawitos/architecture.md

[Service]
Type=simple
ExecStart=/usr/sbin/sawitd --config /etc/sawit/sawitd.yaml
Restart=always
RestartSec=5s
User=root
Group=root
LimitNOFILE=65536
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_SYS_ADMIN
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
